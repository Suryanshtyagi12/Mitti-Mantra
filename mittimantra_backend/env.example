# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Security
SECRET_KEY=your-secret-key-change-this-to-something-very-secure-and-random
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application
APP_NAME=Mittimantra
APP_VERSION=1.0.0
DEBUG=True

# Email Config for OTP
EMAIL_USER=
EMAIL_PASSWORD=

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Hugging Face CNN Model Config
HF_MODEL_REPO=tyagisurya001/plant-disease-detector
HF_MODEL_CONFIG=config.json
HF_MODEL_WEIGHTS=model.weights.h5
HF_MODEL_METADATA=metadata.json
